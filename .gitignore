data/*
!data/.gitkeep
!data/flight_path.csv
!data/survey_path.csv
weights/*
!weights/.gitkeep
*.engine
*.onnx

# runtime output
ground_station/received/
*.db
*.log
# UI v3 frontend
ground_station/web/node_modules/
ground_station/web/test-results/
ground_station/web/playwright-report/

# Ultralytics settings written by the Jetson container
.ultralytics/

# shared drone <-> station secret (never commit)
.link_key
