# Optional: CSI camera -> http://127.0.0.1:8090/stream.mjpg on the host.
[Unit]
Description=CSI camera MJPEG bridge for the edge pipeline
After=nvargus-daemon.service
Wants=nvargus-daemon.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 REPO_DIR/jetson/camera_bridge.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
