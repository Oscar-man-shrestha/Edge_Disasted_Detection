# Copied to /etc/default/edge-drone by install_service.sh. Edit there, then:
#   sudo systemctl restart edge-drone
EDGE_DEVICE=0
EDGE_PERSON_WEIGHTS=weights/yolov8n.engine
EDGE_FIRE_WEIGHTS=weights/fire_smoke.engine
# Lenovo USB webcam. For a CSI camera use the bridge instead:
#EDGE_SOURCE=http://127.0.0.1:8090/stream.mjpg
EDGE_SOURCE=0
# Found automatically from the ground station beacon; or set http://<laptop-ip>:5000
EDGE_SERVER_URL=auto
#EDGE_LINK_KEY=change-me   # must match GS_LINK_KEY on the laptop
# u-blox NEO-M8N on the Nano UART (pins 8/10). USB-serial adapter: /dev/ttyUSB0
EDGE_GPS=nmea
EDGE_GPS_PORT=/dev/ttyTHS1
#EDGE_GPS=sim
